    {
      "description": "表示グループを作る（config スコープ）。ペンに Hub のカタログのタグ（hubTag）を指定すると、未登録のものは hubTagGroup に記録項目として同じ保存の中で登録する（そのときは結果に registeredTags と restartRequired: true が付き、収集へは restart_collection で反映する）。",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "attributes": {
            "description": "種別ごとの属性（trend の timeWindowSec など）。",
            "type": "object"
          },
          "bundle": {
            "description": "束の名前（任意、50 文字以内）。同じ名前のグループが 1 つの束になり、監視画面で束 → グループの順に切り替える。null・空は束なし。",
            "type": [
              "string",
              "null"
            ]
          },
          "hubTagGroup": {
            "additionalProperties": false,
            "description": "未登録の hubTag を登録する先。Hub 接続の既存の収集グループ（collectionGroupId）か新しいグループ（newGroup）のどちらか 1 つ。未登録の hubTag が無ければ使わない。",
            "properties": {
              "collectionGroupId": {
                "description": "Hub 接続の下の既存の収集グループの id。",
                "type": "integer"
              },
              "newGroup": {
                "additionalProperties": false,
                "description": "新しく作る収集グループ（Hub 接続が無ければ暗黙に作る）。",
                "properties": {
                  "name": {
                    "description": "収集グループの名前。",
                    "type": "string"
                  },
                  "periodMs": {
                    "description": "収集の周期（ミリ秒）。",
                    "type": "integer"
                  }
                },
                "required": [
                  "name",
                  "periodMs"
                ],
                "type": "object"
              }
            },
            "type": "object"
          },
          "kind": {
            "description": "表示の種別。",
            "enum": [
              "trend",
              "digital",
              "bar",
              "gauge"
            ],
            "type": "string"
          },
          "name": {
            "description": "表示グループの名前。",
            "type": "string"
          },
          "pens": {
            "description": "ペン（表示する記録項目）の並び。各ペンは tagId か hubTag のどちらか 1 つを指定する。",
            "items": {
              "additionalProperties": false,
              "properties": {
                "colorSlot": {
                  "description": "系列色の枠（1〜16）。省略は既定。",
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "hubTag": {
                  "additionalProperties": false,
                  "description": "Hub のカタログのタグ（tagId の代わり）。登録済みの外部名なら既存の記録項目を参照し、未登録なら hubTagGroup の収集グループに記録項目として登録する（表示グループの保存と全部か無しか）。",
                  "properties": {
                    "dataType": {
                      "description": "データ型（数値と bit だけ登録できる）。",
                      "type": "string"
                    },
                    "decimals": {
                      "description": "小数桁（0〜6 に丸める）。",
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "externalName": {
                      "description": "Hub のタグの外部名（同一性の鍵）。",
                      "type": "string"
                    },
                    "name": {
                      "description": "記録項目の名前（Hub のタグ名）。",
                      "type": "string"
                    },
                    "unit": {
                      "description": "単位。",
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "externalName",
                    "name",
                    "dataType"
                  ],
                  "type": "object"
                },
                "tagId": {
                  "description": "登録済みの記録項目の id。hubTag と同時には指定できない。",
                  "type": "integer"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "sortOrder": {
            "description": "並び順。省略は末尾。",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "kind"
        ],
        "type": "object"
      },
      "name": "create_display_group"
    },
