{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BantoHub",
  "version": "0.1.0",
  "identifier": "dev.tyaro.banto-hub-shell",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "banto-hub",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
