{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window local assets and pinned service HTTPS. Desktop shell origin is registered precisely at runtime after exclusive bind.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-host-switch-status",
    "allow-switch-to-service",
    "allow-switch-to-desktop",
    "allow-set-service-autostart",
    "allow-sink-service-status",
    "allow-sink-service-start",
    "allow-sink-service-stop",
    "allow-restore-setting-mode",
    "allow-retry-startup"
  ],
  "remote": {
    "urls": ["https://127.0.0.1:8723/*"]
  }
}
