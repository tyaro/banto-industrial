# banto-hub-sink（DB Sink サイドカー）設定ファイルの雛形。
#
# インストーラ（banto-hub-elev.exe prepare-sink-config）が、このファイルを
# %ProgramData%\BantoHub\sink\banto-hub-sink.toml.example として置きます
# （インストールのたびに差し替えます。ここに書き足したものは消えます）。
# 実際の `banto-hub-sink.toml` は作りません - API キーは Hub を起動して
# 発行するまで存在しないためです。
#
# 設定ファイルの置き場は %ProgramData%\BantoHub\sink\banto-hub-sink.toml
# だけです（SYSTEM と Administrators だけが開ける置き場。旧いルート直下・
# exe の隣は読みません。旧い場所にファイルがあると起動しません）。
#
# 作り方:
#   1. 管理者としてメモ帳を開き（例: PowerShell で
#      Start-Process notepad -Verb RunAs）、この置き場の中でこのファイルを
#      コピーして banto-hub-sink.toml を作ります。外で作ったファイルを
#      置き場へ移動しないでください（移動は元の ACL を持ってきます）。
#   2. hub_url と api_key を書いて保存します。
#   3. 管理者の PowerShell で banto-hub-elev.exe prepare-sink-config を実行し、
#      置き場とファイルの所有者・ACL を整えます（メモ帳で保存すると所有者が
#      編集した管理者になり、そのままでは sink が起動しません。編集のたびに
#      実行してください）。
#   4. Start-Service BantoHubSink
#
# 必須。Hub と同一マシンで使用する専用 TLS 待受のループバック URL。
# Hub の Windows サービスは、既定で 127.0.0.1:8723 に TLS を待ち受けます
# （鍵と証明書はインストーラが banto-hub-elev.exe prepare-hub-tls で
# %ProgramData%\BantoHub\tls\ に作ります）。平文の http は、Sink が起動する
# 前・API キーを送る前に断ります。
# Hub's Windows service listens for loopback TLS on 127.0.0.1:8723 by default.
# Plain loopback HTTP is rejected before the Sink starts or sends an API key.
hub_url = "https://127.0.0.1:8723"

# 必須。Hub の証明書の pin（最大 2 つ）。管理者のメモ帳で
# %ProgramData%\BantoHub\tls\hub-cert.pem を開き、PEM 全体
# （-----BEGIN CERTIFICATE----- から -----END CERTIFICATE----- まで）を
# 次の形で貼ります:
#   hub_tls_pinned_certs = ["""
#   -----BEGIN CERTIFICATE-----
#   ...
#   -----END CERTIFICATE-----
#   """]
# 上の URL から取得した証明書を pin にしないでください（Hub が止まっている間に
# 別のプロセスが 8723 を取っていれば、その相手の証明書になります）。
# prepare-hub-tls --renew で作り直したら、新しい証明書に書き換えてください
# （切り替えの間は旧い証明書と新しい証明書の 2 つを並べ、確かめてから旧い方を
# 消します）。
# Paste the whole PEM of %ProgramData%\BantoHub\tls\hub-cert.pem here.
# Never retrieve a pin from the URL above.
hub_tls_pinned_certs = []

# 必須。Hub の管理 UI で発行した API キー。スコープは `admin` と
# `read` の両方が必要（admin だけでは /api/v1/{tags,values,stream} が
# 403 になる）。このファイルに平文で置かれる - 置き場の ACL で守る。
api_key = ""
