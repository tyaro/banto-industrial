* text=auto

# ソース/設定/ドキュメントはLFで統一
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svelte text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sql text eol=lf
*.sh text eol=lf

# Windows向けスクリプトはCRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
