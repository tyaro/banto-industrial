* text=auto

# ソース/設定/ドキュメントはLFで統一
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svelte text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sql text eol=lf
*.sh text eol=lf

# Windows向けスクリプトはCRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# tauri-bundler の installer.nsi の写し。byte 単位で原本と同じでなければならない
# （SHA-256 の試験と、改行を含む当て直しの土台。CRLF にすると当て直しが止まる）
installer-common/nsis-template/installer.nsi -text
