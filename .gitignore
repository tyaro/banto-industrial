# Playwright (R1-A e2e/). `outputDir`/the HTML reporter's `outputFolder` are
# pinned under e2e/ in playwright.config.ts, but Playwright always writes its
# own `.last-run.json` relative to the process cwd regardless - `pnpm e2e`
# runs from the repo root, so a root-level `/test-results/` also needs
# ignoring.
e2e/test-results/
e2e/playwright-report/
e2e/.cache/
/test-results/

# Playwright (T18-1 banto-hub e2e/) - e2e/banto-hub.playwright.config.ts
# pins its own outputDir/HTML reporter folder separate from chronogazer's
# above, same reasoning.
e2e/test-results-banto-hub/
e2e/playwright-report-banto-hub/

# Playwright (T18-5a 第2段 banto-hub 性能計測ハーネス, opt-in) -
# e2e/banto-hub-perf.playwright.config.ts が使う出力先。計測結果 JSON
# （e2e/perf-results/）はローカル実測のスナップショットなのでコミットしない。
e2e/test-results-banto-hub-perf/
e2e/playwright-report-banto-hub-perf/
e2e/perf-results/

# Playwright (H5 relay-wright e2e/) - e2e/relay-wright.playwright.config.ts
# pins its own outputDir/HTML reporter folder separate from
# chronogazer's/banto-hub's above, same reasoning.
e2e/test-results-relay-wright/
e2e/playwright-report-relay-wright/

# Local T17 real-machine verification staging (binaries + private target/)
_verify_t17/

# pnpm-lock.yaml is intentionally NOT ignored - the lockfile is committed
